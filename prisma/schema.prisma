// Prisma schema — NextIA Marketing (Vídeos de Alojamento + Sites com IA)
//
// Produção: Postgres (Neon, via integração Vercel Marketplace).
// Desenvolvimento local: se preferires SQLite em vez de apontar para o
// Postgres de produção, troca `provider` para "sqlite" e `DATABASE_URL`
// no .env para "file:./dev.db" — o resto do schema não muda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pedido de reunião para o serviço de vídeos. A geração do vídeo em si NÃO
// é automática no site — a equipa marca uma reunião com o cliente, recebe
// as fotos à parte, e produz o vídeo manualmente (com o apoio de IA).
model MeetingRequest {
  id           String   @id @default(cuid())
  clientName   String
  clientEmail  String
  clientPhone  String?
  propertyName String
  propertyType String // "airbnb" | "alojamento_local" | "hotel"
  message      String?
  status       String   @default("novo") // novo | em_contacto | fechado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebsiteLead {
  id           String   @id @default(cuid())
  clientName   String
  clientEmail  String
  clientPhone  String?
  companyName  String
  businessType String
  needs        String // texto livre ou JSON com checkboxes selecionadas
  budgetRange  String? // "<1000" | "1000-5000" | "5000+" | "nao_sei"
  message      String?
  status       String   @default("novo") // novo | em_contacto | fechado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
