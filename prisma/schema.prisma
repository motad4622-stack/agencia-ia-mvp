// Prisma schema — NextIA Marketing (Vídeos de Alojamento + Sites com IA)
//
// Produção: Postgres (Neon, via integração Vercel Marketplace).
// Desenvolvimento local: se preferires SQLite em vez de apontar para o
// Postgres de produção, troca `provider` para "sqlite" e `DATABASE_URL`
// no .env para "file:./dev.db" — o resto do schema não muda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WebsiteLead {
  id           String   @id @default(cuid())
  clientName   String
  clientEmail  String
  clientPhone  String?
  companyName  String
  businessType String
  needs        String // texto livre ou JSON com checkboxes selecionadas
  budgetRange  String? // "<1000" | "1000-5000" | "5000+" | "nao_sei"
  message      String?
  status       String   @default("novo") // novo | em_contacto | fechado
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Contas ──────────────────────────────────────────────────────────
// Marcar reunião e pedir briefing exigem conta iniciada. As sessões são
// JWT (é o que o Auth.js exige para o login com password), por isso o
// modelo Session existe só porque o adaptador Prisma o pede.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // nulo em contas criadas só com Google
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  bookings        Booking[]
  websiteLeads    WebsiteLead[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Marcações ───────────────────────────────────────────────────────
// A agenda é do próprio site (sem Google Calendar). slotKey guarda o
// início da reunião enquanto a marcação está ativa e fica a null quando
// é cancelada: o índice único impede duas pessoas na mesma hora, mas
// deixa voltar a marcar um horário libertado.

model Booking {
  id          String   @id @default(cuid())
  service     String // videos | sites
  startsAt    DateTime
  durationMin Int      @default(30)
  slotKey     String?  @unique
  clientName  String
  clientEmail String
  clientPhone String?
  subject     String // nome do imóvel ou da empresa
  subjectType String // airbnb | alojamento_local | hotel | tipo de negócio
  message     String?
  status      String   @default("marcada") // marcada | realizada | cancelada
  // Link de cancelamento enviado ao cliente (o email não exige sessão).
  cancelToken    String?   @unique
  cancelledAt    DateTime?
  // Hora a que saiu o lembrete da véspera — garante que só sai uma vez.
  reminderSentAt DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

// Períodos em que a agenda não aceita marcações (férias, uma tarde ocupada).
model BlockedSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

// Registo de cada email enviado. Um envio falhado nunca desfaz a
// marcação: fica aqui com o erro, e pode ser reenviado do /admin.
model EmailLog {
  id         String   @id @default(cuid())
  kind       String // booking_client | booking_admin | reminder_client | reminder_admin | cancel_admin | account_admin | briefing_client | briefing_admin
  refId      String // id da marcação, da conta ou do briefing
  to         String
  subject    String
  status     String // enviado | falhou
  providerId String?
  error      String?
  attempts   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([kind, refId])
}
